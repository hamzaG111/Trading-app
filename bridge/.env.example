# Copy to bridge/.env and fill in. NEVER commit bridge/.env (it's gitignored).

# Force the built-in simulator (no MetaTrader 5 needed) — safe for testing the
# whole pipeline. Set to 0 (or remove) once you've added real credentials below.
MT5_MOCK=1

# --- Real MetaTrader 5 (FundedNext and other MT5 prop firms / brokers) ---
# Get these from your funded account dashboard. Keep them secret.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: explicit path to terminal64.exe if auto-detect fails.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Symbols to trade — must exist in your broker's Market Watch.
MT5_SYMBOLS=EURUSD,GBPUSD,XAUUSD,BTCUSD,US30

# Bridge port — must match MT5_BRIDGE_URL used by the Node server.
MT5_BRIDGE_PORT=8799

# Starting balance for MOCK mode only.
MT5_BALANCE=100000
