{
  "name": "aurum-quant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AURUM — A personal quantitative trading research & risk-management platform (web + mobile PWA).",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "bridge": "python3 bridge/mt5_bridge.py",
    "dev:all": "concurrently -n web,engine -c yellow,magenta \"npm run dev\" \"npm run server\"",
    "smoke": "tsx scripts/smoke.ts",
    "quant": "tsx scripts/quant-test.ts",
    "engine": "tsx scripts/integration-test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:shots": "node scripts/shots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "puppeteer": "^25.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
