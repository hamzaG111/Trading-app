# Copy to ".env" if you need to override defaults. NEVER commit real secrets.

# --- Autopilot server execution backend ---
# "paper" = in-process simulator (default). "mt5" = real account via the bridge.
BROKER=paper

# Base URL of the Python MT5 bridge (see bridge/README.md).
MT5_BRIDGE_URL=http://127.0.0.1:8799

# Symbols to trade in MT5 mode (overridden by the bridge's own list if present).
MT5_SYMBOLS=EURUSD,GBPUSD,XAUUSD,BTCUSD,US30

# --- Frontend ---
# Where the web app reaches the autopilot server (defaults to localhost:8787).
# VITE_API_URL=http://localhost:8787
